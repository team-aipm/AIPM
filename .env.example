# COM-005 §8 · 환경변수 예시
#
# 규칙
#   - 이 파일에는 변수 "이름"만 기록한다. 실제 값을 넣지 않는다.
#   - 실제 값은 각자 .env.local 에 넣는다. .env.local 은 커밋하지 않는다.
#   - 환경변수 이름을 PM별로 임의 생성하지 않는다. 새 변수가 필요하면
#     팀에서 공통 이름을 합의하고 이 파일을 먼저 수정한다.
#   - Production Secret 은 Vercel Environment Variables 에서 관리한다.

# === Supabase (COM-005 §9) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 코드에서 절대 import 하지 않는다 (DEV-001 §8)
SUPABASE_SERVICE_ROLE_KEY=

# === Google Gemini (COM-005 §4) ===
GEMINI_API_KEY=

# === 개발 도구 prompt-lab (DEV-001 §2 규칙 6) ===
# 배포본에서 /prompt-lab 을 여는 통과 암호. 팀 공용 문자열 하나.
# 비워두면 배포본에서 404 다. 개발 서버(npm run dev)에서는 필요 없다.
# 실제 값은 Vercel Environment Variables 에 넣는다.
PROMPT_LAB_PASSCODE=

# 도구가 쓰는 Gemini 키. **제품 키(GEMINI_API_KEY)와 일부러 나눈다.**
# 배포본의 도구는 암호만 알면 들어온다. 거기서 제품 키를 쓰면 학생이 쓸
# 몫을 도구가 갉아먹고, 어디서 얼마나 썼는지 구분되지 않는다.
# 비워두면 도구는 화면에 직접 넣은 키만 쓴다.
# 개발 서버에서는 GEMINI_API_KEY 로 물러난다.
PROMPT_LAB_GEMINI_API_KEY=

# === 배치 (vercel.json Cron) ===
# /api/batch/* 를 부를 때 Authorization: Bearer <값> 으로 확인한다.
# 비워두면 배치가 401 로 막힌다 — 아무나 부르게 두지 않는다.
CRON_SECRET=

# === 아래는 미확정 (COM-005 §13) ===
# 담당 PM이 후보를 검토하고 팀에서 확정한 뒤 주석을 해제한다.

# 결제 PG
# PAYMENT_API_KEY=
# PAYMENT_SECRET=

# SMS / 알림톡
# SMS_API_KEY=
# KAKAO_ALIMTALK_KEY=
